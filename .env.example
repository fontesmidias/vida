# Copie para .env e preencha. Nunca commite o .env (S3).

# Postgres (docker compose)
POSTGRES_USER=vida
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=vida

# Prisma
DATABASE_URL=postgresql://vida:troque-esta-senha@localhost:5432/vida?schema=public

# Sessão (S4): mínimo de 32 caracteres. Gere com: openssl rand -base64 48
SESSION_SECRET=
